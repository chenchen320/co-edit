generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Document {
  id        String   @id
  title     String   @default("无标题文档")
  content   String?
  createdAt DateTime @default(now())
  authorId  String?
  updatedAt DateTime
  User      User?    @relation(fields: [authorId], references: [id])
}

model User {
  id        String     @id
  email     String     @unique
  password  String
  username  String
  createdAt DateTime   @default(now())
  updatedAt DateTime
  Document  Document[]
}
